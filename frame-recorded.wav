:root{color-scheme:dark}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#071019}main{position:fixed;inset:0;width:100%;height:100dvh;display:flex;align-items:center;justify-content:center}#instrument{display:block;width:100%;height:100%;max-width:100%;max-height:100%;touch-action:none;user-select:none}.control{cursor:pointer;outline:none}.pending{cursor:not-allowed}.control:focus-visible{filter:drop-shadow(0 0 5px #b9dbf9)}.control:hover>rect{stroke:#8eb5cb}.icon-button[aria-pressed=true]>rect{fill:#203a4b;stroke:#739fa3}.icon-button[aria-pressed=false]>rect{fill:#101f2d;stroke:#304b61}.icon-button[aria-pressed=true]>g{stroke:#c8e3df}.step[aria-pressed=true]>rect{fill:#659486;stroke:#bdd9c5}.step.row-1[aria-pressed=true]>rect{fill:#507da8;stroke:#b4d8ef}.power.ready>ellipse{fill:#204b4a;stroke:#b4dace}.power.failed>ellipse{fill:#54313a;stroke:#d19ba8}#moving-fog{transform-origin:50% 50%;animation:drift 16s ease-in-out infinite alternate}#portal-halo{animation:breath 9s ease-in-out infinite alternate}.motion-paused #moving-fog,.motion-paused #portal-halo{animation-play-state:paused}.sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}@keyframes drift{from{transform:translate(-18px,10px) scale(1)}to{transform:translate(24px,-10px) scale(1.05)}}@keyframes breath{from{opacity:.25}to{opacity:.6}}@media(prefers-reduced-motion:reduce){#moving-fog,#portal-halo{animation:none}}
.step.playing>rect{stroke:#eef9f8;stroke-width:2.5;filter:drop-shadow(0 0 4px #74a7b7)}.icon-button.hit>rect{fill:#3c6070;stroke:#e0edec}.icon-button.failed>rect{stroke:#ce8194}.step[data-sound=whisper][aria-pressed=true]>rect{fill:#76768c}.step[data-sound=wind][aria-pressed=true]>rect{fill:#507d8e}.step[data-sound=string][aria-pressed=true]>rect{fill:#667e98}#play-sequence[aria-pressed=true] path{stroke:#c9e7df}.knob,.fader{cursor:ns-resize}.fader{cursor:ew-resize}
/* Явь: светлый мох и латунь. Навь: чернильный индиго и холодное серебро. */
#yav-world .icon-button>rect{fill:#344d43;stroke:#9aab91}#yav-world .icon-button[aria-pressed=true]>rect{fill:#a7ad8b;stroke:#ebe8c9}#yav-world .icon-button[aria-pressed=true]>g{stroke:#283b35}#yav-world .icon-button>g{stroke:#e0e1c6}#yav-world .fader>rect{stroke:#a6b49b}#yav-world .fader>g{stroke:#e2e3c8}#yav-world .fader-fill{stroke:#d5daba}#yav-world .knob>ellipse{stroke:#aebba1}#yav-world .knob>g{stroke:#d9dfc5}#nav-world .icon-button>rect{fill:#141525;stroke:#4b4967}#nav-world .icon-button[aria-pressed=true]>rect{fill:#39324e;stroke:#ada6ca}#nav-world .icon-button>g{stroke:#a6adcf}#nav-world .icon-button.hit>rect{fill:#51435e;stroke:#d0bcdf}.step.row-0[aria-pressed=true]>rect{fill:#a5ac85;stroke:#e1e4c9}.step.row-1[aria-pressed=true]>rect{fill:#5d536f;stroke:#b6acd0}.step.row-0[data-sound=drum][aria-pressed=true]>rect{fill:#8b8063}.step.row-0[data-sound=frame][aria-pressed=true]>rect{fill:#a09174}.step.row-1[data-sound=beast][aria-pressed=true]>rect{fill:#6c414e}.step.row-1[data-sound=spirit][aria-pressed=true]>rect{fill:#776789}
#morok-fog{position:fixed;inset:0;width:100%;height:100%;z-index:2;pointer-events:none;user-select:none}

#yav-world .icon-button.hit>rect{fill:#d1cfa4;stroke:#fff5d1;filter:drop-shadow(0 0 5px #babd86)}
#yav-world .icon-button.hit>g{stroke:#233c32}
